# Copia este archivo a .env.local y completa los valores reales. Nunca commitear .env.local.

# Base de datos (Postgres vía Supabase). Con `supabase start` corriendo localmente, la URL por
# defecto del CLI es la de abajo — solo cámbiala si tu instancia local usa otro puerto.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase (Auth, Storage, Realtime) — `supabase start` imprime estos valores en consola.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (modo test en desarrollo — dashboard.stripe.com, modo test activado)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Opcional — secreto del destino de webhook de "Cuentas conectadas" (account.updated). Solo
# necesario si creaste un segundo destino separado del de "Tu cuenta" (checkout.session.completed).
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Resend (correo transaccional)
RESEND_API_KEY=""

# Cron de expiración de holds — genera un valor aleatorio propio, no uses este ejemplo
CRON_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"

# Observabilidad
SENTRY_DSN=""

# Producción (solo usado por el `Verify` del paso de deploy)
PRODUCTION_DOMAIN="tu-dominio.com"
